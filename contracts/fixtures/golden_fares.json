      "expected_shares_raw": {
        "A": 78.33333333333333,
        "B": 38.333333333333336,
        "C": 23.333333333333332
      },
      "notes": "Exact Shapley with largest-remainder rounding distributes remaining paise so total equals 140.00 exactly."
    },
    {
